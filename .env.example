# CeliacMap — agent configuration (copy to .env and fill in).
# Secrets are server-side only: keep them in .env locally and in GitHub Actions
# Secrets in CI. NEVER expose the service_role or any API key in the frontend.

# --- Supabase (service_role: bypasses RLS, agents only) ---------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Paid APIs --------------------------------------------------------
GOOGLE_MAPS_API_KEY=        # Google Places (Search / Updater / Social agents)
ANTHROPIC_API_KEY=          # Claude API (Validator; Updater + Social haiku)

# --- Tavily Search (Social agent) -------------------------------------
# Tavily web search, used to discover public Instagram / Facebook pages.
# Free tier: 1000 searches/month. Sign up at https://tavily.com
TAVILY_API_KEY=

# --- Models (optional; sensible defaults shown) -----------------------
VALIDATOR_MODEL=claude-sonnet-4-6
HAIKU_MODEL=claude-haiku-4-5
# Web discovery agent (v3): reasons freely + uses the Anthropic web search tool.
WEB_SEARCH_MODEL=claude-haiku-4-5

# --- Run caps / budget (optional; defaults shown) ---------------------
MAX_SEARCH_RESULTS_PER_QUERY=20
# Cap on text-search queries per Search run (city x term matrix); 0 = unlimited.
MAX_SEARCH_QUERIES_PER_RUN=104
MAX_VALIDATIONS_PER_RUN=50
MAX_UPDATES_PER_RUN=50
# Social agent caps (kept well under the Tavily 1000/month free tier).
MAX_SOCIAL_QUERIES_PER_RUN=30
MAX_REVIEW_ENRICHMENTS_PER_RUN=30
# Place Details lookups per Search run (rich panel fields + review enrichment).
MAX_DETAIL_LOOKUPS_PER_RUN=60
# Web discovery agent (v3): cities researched per run (opt-in via web: true in
# targets.yaml) and web searches handed to the model per city.
MAX_WEB_CITIES_PER_RUN=2
MAX_WEB_SEARCHES_PER_CITY=8
# Public "Suggest a Place" form: submissions promoted per daily run (each costs
# one Google Find Place geocode).
MAX_SUGGESTIONS_PER_RUN=30
# Outreach agent cap (7th pipeline stage, shares the combined budget).
OUTREACH_MONTHLY_LIMIT=20
# Outreach agent's contact_email scraper: websites scraped per run.
MAX_EMAIL_SCRAPES_PER_RUN=30
# Community reports monthly sweep (8th pipeline stage, ReviewHandler.sweep()):
# re-drives negative reports the real-time webhook path left stuck. Default is
# low — in the normal case there is nothing stuck to sweep.
MAX_REVIEW_SWEEP_PER_RUN=20
# Combined cap on paid API calls for one full pipeline run (run_agents.py).
AGENT_DAILY_BUDGET=350

# --- Resend (Outreach agent) -------------------------------------------
# Sandbox sender (onboarding@resend.dev) can only deliver to the address
# below until a custom domain is verified with Resend.
RESEND_API_KEY=
OUTREACH_TEST_RECIPIENT=
# From-address for outreach emails. Requires outreach@celiacmap.org's domain
# to be verified with Resend to actually deliver; the recipient stays
# OUTREACH_TEST_RECIPIENT above regardless (ADR-003 not yet resolved).
OUTREACH_SENDER_EMAIL=outreach@celiacmap.org
# Outreach Etapa 2 (reply webhook): account's <id>.resend.app inbound
# receiving domain, used to build a unique Reply-To per send. Leave blank
# until the reply webhook (supabase/functions/outreach-reply/) is deployed.
OUTREACH_INBOUND_DOMAIN=
# ADR-003 final step: when true, outreach emails go to each place's real
# contact_email instead of OUTREACH_TEST_RECIPIENT above. Defaults to false.
OUTREACH_LIVE_MODE=false
